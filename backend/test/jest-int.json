{
  "rootDir": "..",
  "testEnvironment": "node",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testMatch": [
    "<rootDir>/test/**/*.int-spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFilesAfterEnv": [
    "<rootDir>/test/setup-after-env.ts"
  ],
  "testTimeout": 30000,
  "collectCoverageFrom": [
    "<rootDir>/src/**/*.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage-int",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
